{
  // ───────────────────────────────────────────────────────────────────────────
  // pinhole agent 配置
  //
  // 改这个文件，然后 `./pinhole-agent` 就能把下面列的服务全部转发出去。
  // 支持 // 和 /* */ 注释（读取时会剥掉），所以这份文件是自带说明的。
  // ───────────────────────────────────────────────────────────────────────────

  // ── 信令：这一段所有服务共用 ──────────────────────────────────────────────
  //
  // 默认是公共 MQTT broker，不需要你准备任何服务器。信令只传 SDP/ICE（几 KB），
  // 业务数据全部走 P2P。
  //
  // 想自建的话改成 "ws://你的服务器:8787/ws"（用 `-mode signal` 起）。
  "signal": "mqtts://broker.emqx.io:8883",
  "signalKind": "mqtt",

  // 访问密钥。**必须和浏览器 URL 里的 ?key= 完全一致。**
  //
  // ⚠️ 它同时是信令的签名密钥，所以：
  //   · 别提交进 git，别贴到公开地方
  //   · 越长越好，随便一长串随机字符即可
  //   · 想给不同的服务用不同的密钥，就写在各 service 里覆盖这一条
  "secret": "在这里填一串很长的随机字符",

  // ── 要转发什么：一个服务一段 ─────────────────────────────────────────────
  //
  // room 是**路由键**：浏览器从自己的域名推导出来 ——
  //     nas.example.com   →  room = "nas"
  //     panel.example.com →  room = "panel"
  // 所以「一个子域名 = 一个 service」。
  "services": [
    // ① 最简形态：本机的一个 HTTP 服务（网盘、博客、任意 web 应用）
    {
      "room": "nas",
      "target": "127.0.0.1:5244"
    },

    // ② 只肯说 TLS 的目标（自带证书的面板之类）。
    //
    //    targetTls 的取值：
    //      "off"      明文（默认）。目标说纯 HTTP 时用
    //      "insecure" TLS，不验证证书。自签证书用这个 —— 链路是加密的，
    //                 "对面是谁" 由应用自己的账号密码负责
    //      "verify"   TLS + 验证证书。还想发现"连错服务"时用
    {
      "room": "panel",
      "target": "127.0.0.1:10086",
      "targetTls": "insecure"
    }

    // ③ 再加就往上面接着写，注意**逗号**：
    // {
    //   "room": "blog",
    //   "target": "127.0.0.1:8080",
    //   "secret": "这个服务单独用的密钥"
    // }
  ],

  // ── 可选 ─────────────────────────────────────────────────────────────────

  // STUN 服务器。打洞用；局域网或测试时传空字符串可以关掉。
  "stun": "stun:stun.cloudflare.com:3478"

  // targetTls 用 "verify" 时要额外信任的自签根证书（PEM 文件路径）：
  // "targetTlsCA": "C:\\certs\\my-ca.pem"

  // 证书是签给域名、而 target 写的是 127.0.0.1 时，用它指定要校验的名字：
  // "targetTlsSNI": "panel.example.com"
}
