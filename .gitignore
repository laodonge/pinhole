# Dependencies
node_modules/

# Build output
dist/
dist-demo/
dist-test/
*.tsbuildinfo

# Generated by packages/bootstrap/scripts/copy-sw.mjs. The worker is built by
# packages/service-worker and copied here; never edit the copy.
packages/bootstrap/public/sw.js

# Packaged deployable, produced by the bootstrap build
packages/bootstrap/*.zip

# Release bundles (binaries). The instructions they embed live in docs/ so the
# text is version-controlled while the multi-megabyte archives are not.
release/

# Agent binaries
packages/agent/agent
packages/agent/agent.exe
*.exe

# Go leaves a `~` backup when it replaces a running binary
*~

# ⚠️ The agent's runtime config holds the access key — the only credential in
# this project (it derives the signaling topic and signs every message).
# Never commit it; copy agent.example.json instead.
packages/agent/agent.json

# Cloudflare Workers
.wrangler/
.dev.vars

# Secrets
.env
.env.*
*.pem
*.key

# Local-only working notes (strategy, compliance, pricing). Not part of the
# published technical work.
docs/PLAN.md

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
